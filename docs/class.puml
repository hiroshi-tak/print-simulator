@startuml

class Printer {
    - state : PrinterState
    - error : PrinterError
    - motor : Motor
    - sensor : Sensor
    - device : PrinterDevice*

    + Printer(device : PrinterDevice*)
    + startPrint() : void
    + stopPrint() : void
    + finishPrint() : void

    + getState() : PrinterState

    + getError() : PrinterError
    + setError(error : PrinterError) : void
    + clearError() : void

    + isMotorRunning() : bool

    + setPaperDetected(detected : bool) : void
    + setPaperJamDetected(detected : bool) : void
}

class Motor {
    - running : bool

    + Motor()
    + start() : void
    + stop() : void
    + isRunning() : bool
}

class Sensor {
    - paperDetected : bool
    - paperJamDetected : bool

    + Sensor()

    + setPaperDetected(detected : bool) : void
    + isPaperDetected() : bool

    + setPaperJamDetected(detected : bool) : void
    + isPaperJamDetected() : bool
}

abstract class PrinterDevice {
    + PrinterDevice()
    + ~PrinterDevice()

    {abstract} + print() : void
    {abstract} + print(copies : int) : void
}

class InkjetPrinter {
    + InkjetPrinter()
    + print() : void
    + print(copies : int) : void
}

class LaserPrinter {
    + LaserPrinter()
    + print() : void
    + print(copies : int) : void
}

enum PrinterState {
    IDLE
    PRINTING
    STOPPED
    ERROR
}

enum PrinterError {
    NONE
    PAPER_JAM
    NO_PAPER
    INK_EMPTY
}

Printer --> PrinterState
Printer --> PrinterError

Printer *-- Motor
Printer *-- Sensor
Printer --> PrinterDevice

PrinterDevice <|-- InkjetPrinter
PrinterDevice <|-- LaserPrinter

@enduml